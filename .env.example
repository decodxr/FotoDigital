# URL pública da implantação, sem barra final. Nunca use prefixo NEXT_PUBLIC para secrets.
APP_URL=http://localhost:3000
# Primeiro acesso: gere um código aleatório com pelo menos 32 caracteres.
ADMIN_BOOTSTRAP_TOKEN=
# Somente Sites: e-mails verificados, separados por vírgula (opcional).
ADMIN_EMAILS=
# Chave PIX CNPJ, apenas números; confirmação manual pela loja.
PIX_KEY=
# Vercel: PostgreSQL Neon com TLS. Sites usa o binding DB automaticamente.
DATABASE_URL=
# Vercel: bucket privado S3/R2. Sites usa o binding BUCKET automaticamente.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Bridges HTTPS contratadas/implementadas; veja docs/integrations.md.
CORREIOS_QUOTE_URL=
CORREIOS_API_TOKEN=
JADLOG_QUOTE_URL=
JADLOG_API_TOKEN=
PAYMENT_CREATE_URL=
PAYMENT_API_TOKEN=
PAYMENT_REDIRECT_HOSTS=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_DEBIT_ENABLED=false
