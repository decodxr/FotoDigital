# URL pública da implantação, sem barra final. Nunca use prefixo NEXT_PUBLIC para secrets.
APP_URL=http://localhost:3000
# Primeiro acesso: gere um código aleatório com pelo menos 32 caracteres.
ADMIN_BOOTSTRAP_TOKEN=
# Somente Sites: e-mails verificados, separados por vírgula (opcional).
ADMIN_EMAILS=
# Chave PIX CNPJ, apenas números; confirmação manual pela loja.
PIX_KEY=
# Vercel + Supabase: Connect > Transaction pooler (porta 6543).
# Cole a URI completa e substitua [YOUR-PASSWORD] pela senha do BANCO,
# codificada para URL se houver caracteres especiais. Nunca use a chave anon.
DATABASE_URL=
# Opcional, apenas migrations: Session pooler (5432) ou conexão direta com IPv6.
# Sem DIRECT_URL, o comando de migrations utiliza DATABASE_URL.
DIRECT_URL=
# Opcional: certificado CA do projeto se a conexão precisar de uma CA própria.
# Conteúdo PEM completo, com quebras reais ou \n. Não desative a validação TLS.
DATABASE_CA_CERT=
# Supabase > Storage > Configuration > S3: habilite a conexão S3.
# Copie o endpoint COMPLETO incluindo /storage/v1/s3 e a região exibida.
S3_ENDPOINT=
S3_BUCKET=foto-digital-private
# Credenciais S3, diferentes das API keys publishable/anon/service_role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Estas variáveis são exclusivas do servidor. Supabase Auth não é usado:
# clientes e sessões do próprio site ficam em public.users/public.sessions.
# Não é necessário SUPABASE_URL, SUPABASE_ANON_KEY ou SUPABASE_SERVICE_ROLE_KEY.
# Sites continua usando os bindings DB/BUCKET; este bloco ativa o backend Vercel.
# Bridges HTTPS contratadas/implementadas; veja docs/integrations.md.
CORREIOS_QUOTE_URL=
CORREIOS_API_TOKEN=
JADLOG_QUOTE_URL=
JADLOG_API_TOKEN=
PAYMENT_CREATE_URL=
PAYMENT_API_TOKEN=
PAYMENT_REDIRECT_HOSTS=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_DEBIT_ENABLED=false
